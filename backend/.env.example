# Database Configuration (PostgreSQL / Supabase or local SQLite for offline testing)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evidence_bot
# For offline/local test without PostgreSQL:
# DATABASE_URL=sqlite:///./evidence_bot.db

# Authentication / JWT
JWT_SECRET=super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase Storage Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=evidence-files
# Local storage fallback directory when Supabase is not configured
LOCAL_STORAGE_DIR=./storage_uploads

# Google Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Email Service (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev

# Frontend & CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# APScheduler Settings
REMINDER_INTERVAL_MINUTES=60
# Number of days before due date for reminder 1, 2, and escalation
REMINDER_1_DAYS_BEFORE=2
REMINDER_2_DAYS_BEFORE=1
ESCALATION_DAYS_AFTER=1
